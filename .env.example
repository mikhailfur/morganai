# === Morgan AI Configuration ===

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat-v4-0324

# MySQL Database
# В Docker MYSQL_HOST автоматически = db (имя сервиса из docker-compose)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=morganai

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# MiniMax TTS (для голосовых сообщений, опционально)
MINIMAX_API_TOKEN=your_minimax_api_token
MINIMAX_VOICE_ID=your_minimax_voice_id

# Admin (email через запятую)
ADMIN_EMAILS=admin@example.com

# Server
PORT=3001
# CLIENT_URL — домен фронтенда (используется в CORS)
# В Docker: ваш публичный домен, например https://morgan.example.com
CLIENT_URL=http://localhost:5173

# Docker: порт на хосте для nginx-контейнера (по умолчанию 80)
APP_PORT=80
