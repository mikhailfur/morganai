# ==========================================
# Morgan AI — Конфигурация окружения (.env)
# ==========================================
# Скопируй этот файл:   cp .env.example .env
# Затем отредактируй значения под себя.

# === APP ===
DEBUG=false
ENVIRONMENT=production
APP_NAME=Morgan AI

# === DATABASE ===
# Используется docker-compose сервис 'db'. 
# Если запускаешь backend локально (без Docker), замени 'db' на 'localhost'.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/morgan_ai

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com
TELEGRAM_WEBHOOK_SECRET=change_me_to_random_string_32chars
TELEGRAM_PREMIUM_CHANNEL_ID=-1001234567890

# === OPENROUTER ===
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514

# === MINIMAX (T2A / STT) ===
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# === PADDLE ===
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# === SCHEDULER (APScheduler) ===
PROACTIVE_MESSAGE_CHECK_INTERVAL_MINUTES=60
PROACTIVE_MESSAGE_WINDOW_START_HOUR=9
PROACTIVE_MESSAGE_WINDOW_END_HOUR=21

# === POSTGRES (для сервиса db в docker-compose) ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=morgan_ai
