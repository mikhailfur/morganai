# === Morgan AI Configuration ===

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat-v4-0324

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=morganai

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# MiniMax TTS (для голосовых сообщений)
MINIMAX_API_TOKEN=your_minimax_api_token
MINIMAX_VOICE_ID=your_minimax_voice_id

# Admin (email через запятую)
ADMIN_EMAILS=admin@example.com

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
