# Morgan AI - Environment Variables

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ADMIN_IDS=12345678,87654321

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_MODEL=google/gemini-flash-1.5

# MiniMax (Voice)
MINIMAX_API_KEY=your_minimax_api_key

# Payment Gateways
TRIBUTE_API_KEY=your_tribute_api_key
PADDLE_API_KEY=your_paddle_api_key

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/morganai

# WebApp
WEBAPP_URL=https://webapp.morganai.com
WEBAPP_SECRET_KEY=your_secret_key_for_hmac_sha256_min_32_chars

# Environment
DEBUG=true
